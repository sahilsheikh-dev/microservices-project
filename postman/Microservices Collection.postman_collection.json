{
  "info": {
    "_postman_id": "f37d7f03-1150-4e7f-b289-8276d5bd90a6",
    "name": "Microservices Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    { "key": "userBaseUrl", "value": "http://localhost:8081" },
    { "key": "journalBaseUrl", "value": "http://localhost:8082" },
    { "key": "token", "value": "" },
    { "key": "adminEmail", "value": "admin@example.com" },
    { "key": "adminPassword", "value": "" },
    { "key": "userEmail", "value": "postman-user@example.com" },
    { "key": "userPassword", "value": "" },
    { "key": "userName", "value": "Postman User" },
    { "key": "userId", "value": "" },
    { "key": "journalId", "value": "" }
  ],
  "item": [
    {
      "name": "User service",
      "item": [
        {
          "name": "Service status",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{userBaseUrl}}/"
          }
        },
        {
          "name": "Health",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{userBaseUrl}}/actuator/health"
          }
        },
        {
          "name": "Register user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"registration creates a USER without exposing a password\", function () {",
                  "    pm.response.to.have.status(201);",
                  "    const user = pm.response.json();",
                  "    pm.expect(user.roles).to.eql(\"USER\");",
                  "    pm.expect(user).not.to.have.property(\"password\");",
                  "    pm.collectionVariables.set(\"userId\", user.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{userName}}\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\",\n  \"roles\": \"ADMIN\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{userBaseUrl}}/api/users"
          }
        },
        {
          "name": "Login as registered user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"login returns a bearer token\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.accessToken).to.be.a(\"string\").and.not.empty;",
                  "    pm.collectionVariables.set(\"token\", response.accessToken);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{userBaseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Get current user",
          "request": {
            "method": "GET",
            "url": "{{userBaseUrl}}/api/users/me"
          }
        },
        {
          "name": "Get user by ID (self)",
          "request": {
            "method": "GET",
            "url": "{{userBaseUrl}}/api/users/{{userId}}"
          }
        },
        {
          "name": "Login as administrator",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"login returns a bearer token\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.accessToken).to.be.a(\"string\").and.not.empty;",
                  "    pm.collectionVariables.set(\"token\", response.accessToken);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{userBaseUrl}}/api/auth/login"
          }
        },
        {
          "name": "List users",
          "request": {
            "method": "GET",
            "url": "{{userBaseUrl}}/api/users?page=0&size=20&sort=userId,asc"
          }
        },
        {
          "name": "Get user by ID (administrator)",
          "request": {
            "method": "GET",
            "url": "{{userBaseUrl}}/api/users/{{userId}}"
          }
        },
        {
          "name": "Update user",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{userName}}\",\n  \"email\": \"{{userEmail}}\",\n  \"roles\": \"USER\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{userBaseUrl}}/api/users/{{userId}}"
          }
        },
        {
          "name": "Delete user",
          "request": {
            "method": "DELETE",
            "url": "{{userBaseUrl}}/api/users/{{userId}}"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{userBaseUrl}}/api/auth/logout"
          }
        }
      ]
    },
    {
      "name": "Journal service",
      "item": [
        {
          "name": "Service status",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{journalBaseUrl}}/"
          }
        },
        {
          "name": "Health",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{journalBaseUrl}}/actuator/health"
          }
        },
        {
          "name": "List journals",
          "request": {
            "method": "GET",
            "url": "{{journalBaseUrl}}/api/journals?page=0&size=20&sort=operationTime,desc"
          }
        },
        {
          "name": "List journals by user ID",
          "request": {
            "method": "GET",
            "url": "{{journalBaseUrl}}/api/journals/user/{{userId}}?page=0&size=20&sort=operationTime,desc"
          }
        },
        {
          "name": "Get journal by ID",
          "request": {
            "method": "GET",
            "url": "{{journalBaseUrl}}/api/journals/{{journalId}}"
          }
        },
        {
          "name": "Delete journal",
          "request": {
            "method": "DELETE",
            "url": "{{journalBaseUrl}}/api/journals/{{journalId}}"
          }
        }
      ]
    }
  ]
}
